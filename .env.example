# Lunar Application - Environment Variables
# Copy this file to .env and fill in your values


```env

MONGODB_URI=Your mongoDB URI local or Atlas
JWT_SECRET=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY= 60 * 60 * 24 * 30 //<- 30 days for refresh token experation
JWT_TOKEN_EXPIRY = 900 //<- 15 minutes populates the front-end
SESSION_EXPIRY= 60 * 15 //<- 15 minutes used in the server
SESSION_SECRET=StrongRandomString
COOKIE_SECRET=StrongrandomString

WHITELISTED_DOMAINS=http://localhost:5173 //<- if you keep these consistent you can change these as the application uses thse strings 
FRONTEND_URL=http://localhost:5173
PORT=5050
API_URL=http://localhost:5050


```
# ============================================
# MongoDB Configuration
# ============================================
# For local MongoDB:
# your local MongoDB URI,
# example: mongodb://localhost:27017/Lunar

# For MongoDB Atlas (cloud):
# example:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/Lunar?retryWrites=true&w=majority

# ============================================
# JWT Secrets (Authentication)
# ============================================
# Generate strong random strings for production
# For development, you can use any string
# Tip: Use `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` to generate

# ============================================
# Server Configuration
# ============================================

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed frontend origins
# Example: http://localhost:5173,http://localhost:3000,https://yoursite.com
# WHITELISTED_DOMAINS=frontendURL,otherFrontendURL CORS configuration for allowed origins

# ============================================
# Optional: API Rate Limiting (if implemented)
# ============================================
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100


**FRONTEND ENV STRUCTURE **

``` env

VITE_API_URL=http://localhost:5050 <- or whatever port points to your server
SENTRY_ID=yourSentryURL

```

# ============================================
# Frontend Configuration
# VITE_API_URL should match the API_URL in the backend .env for development
# SENTRY_ID is optional for error tracking if you choose to implement Sentry
# ============================================

